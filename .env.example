# Auth — the API refuses to serve unless a key is set (or auth is disabled).
OCR_API_KEY=
OCR_REQUIRE_API_KEY=true

# Model
# Token used when downloading/accessing the model. MODEL_API_KEY is the
# user-facing variable; HF_TOKEN remains supported for Hugging Face tooling.
MODEL_API_KEY=
HF_TOKEN=
OCR_MODEL_NAME=baidu/Unlimited-OCR
OCR_OUTPUT_DIR=outputs
OCR_DEVICE=cuda

# Request limits.
# max_pages is the important one: pdf_to_images rasterises every page and
# infer_multi sends them all in a single call, so a small file with many pages
# is far more expensive than a large single-page one.
OCR_MAX_PAGES=10
OCR_MAX_UPLOAD_BYTES=20971520
OCR_MAX_DPI=400
